<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema da janela enquanto o app abre: o cão caramelo sobre Ferro 900.
         Some sozinho quando o Flutter desenha o primeiro quadro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fundo da janela atrás do Flutter: Ferro 900, para não piscar branco
         entre a abertura e a primeira tela. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
