        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"itens_plano\" (\"atualizado_em\" TEXT NOT NULL, \"excluido_em\" TEXT NULL, \"sincronizado_em\" TEXT NULL, \"id\" TEXT NOT NULL, \"sessao_plano_id\" TEXT NOT NULL REFERENCES sessoes_plano (id), \"exercicio_id\" TEXT NOT NULL REFERENCES exercicios (id), \"ordem\" INTEGER NOT NULL, \"series\" INTEGER NOT NULL, \"reps_min\" INTEGER NOT NULL, \"reps_max\" INTEGER NOT NULL, \"rir_alvo\" INTEGER NULL, \"descanso_s\" INTEGER NOT NULL, \"carga_plan_kg\" REAL NULL, \"justificativa\" TEXT NULL, \"fonte_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
