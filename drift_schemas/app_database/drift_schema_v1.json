          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"planos_treino\" (\"atualizado_em\" TEXT NOT NULL, \"excluido_em\" TEXT NULL, \"sincronizado_em\" TEXT NULL, \"id\" TEXT NOT NULL, \"usuario_id\" TEXT NULL, \"divisao\" TEXT NOT NULL, \"semanas\" INTEGER NOT NULL, \"inicio_em\" TEXT NOT NULL, \"versao\" INTEGER NOT NULL DEFAULT 1, \"ativo\" INTEGER NOT NULL DEFAULT 1 CHECK (\"ativo\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
