      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"treinos\" (\"atualizado_em\" TEXT NOT NULL, \"excluido_em\" TEXT NULL, \"sincronizado_em\" TEXT NULL, \"id\" TEXT NOT NULL, \"usuario_id\" TEXT NULL, \"sessao_plano_id\" TEXT NOT NULL REFERENCES sessoes_plano (id), \"iniciado_em\" TEXT NOT NULL, \"finalizado_em\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'andamento' CHECK(\"status\" IN ('andamento', 'concluido', 'parcial')), \"modo\" TEXT NOT NULL DEFAULT 'normal' CHECK(\"modo\" IN ('normal', '20min')), PRIMARY KEY (\"id\"));"
        }
