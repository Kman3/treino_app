          "sql": "CREATE TABLE IF NOT EXISTS \"series\" (\"atualizado_em\" TEXT NOT NULL, \"excluido_em\" TEXT NULL, \"sincronizado_em\" TEXT NULL, \"id\" TEXT NOT NULL, \"treino_id\" TEXT NOT NULL REFERENCES treinos (id), \"item_plano_id\" TEXT NULL REFERENCES itens_plano (id), \"exercicio_id\" TEXT NOT NULL REFERENCES exercicios (id), \"numero\" INTEGER NOT NULL, \"carga_plan_kg\" REAL NULL, \"reps_plan\" INTEGER NULL, \"carga_kg\" REAL NULL, \"reps\" INTEGER NULL, \"rir\" INTEGER NULL CHECK(\"rir\" BETWEEN 0 AND 4), \"confirmado\" INTEGER NOT NULL DEFAULT 0 CHECK (\"confirmado\" IN (0, 1)), \"editado\" INTEGER NOT NULL DEFAULT 0 CHECK (\"editado\" IN (0, 1)), \"dor\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dor\" IN (0, 1)), \"registrada_em\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
