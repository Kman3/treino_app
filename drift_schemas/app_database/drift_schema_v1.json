      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercicios\" (\"id\" TEXT NOT NULL, \"nome\" TEXT NOT NULL, \"musculos_alvo\" TEXT NOT NULL, \"padrao_movimento\" TEXT NOT NULL, \"equipamento\" TEXT NOT NULL, \"tipo_carga\" TEXT NOT NULL CHECK(\"tipo_carga\" IN ('externa', 'corporal', 'tempo')), \"passo_carga_kg\" REAL NOT NULL DEFAULT 2.5, \"video_url\" TEXT NULL, \"fonte_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
